{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "reserva-armamento",
  "version": "0.1.3",
  "identifier": "br.gov.pmdf.reserva-armamento",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev:staging",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Reserva de Armamento",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "RWTbi4AdeXLCeiggHwXpYeIyXQgQLbwjyfTNijRBjSRkrMp/q3gnhGk",
      "endpoints": [
        "https://github.com/wilsonjuniorwy-hue/Reserva-de-armamento/releases/latest/download/latest.json"
      ]
    }
  }
}
